# Copy to .env and adjust. All values have safe development defaults.
HFS_DATABASE_URL=sqlite:///./hfs.db
HFS_SECRET_KEY=change-me-to-a-long-random-string
HFS_ACCESS_TOKEN_MINUTES=480
HFS_CURRENCY=INR
HFS_TAX_RATE_PERCENT=5
HFS_STANDARD_HOURS_PER_DAY=8
HFS_OVERTIME_MULTIPLIER=1.5
HFS_STATUTORY_DEDUCTION_PERCENT=12
HFS_ALLOWANCE_PERCENT=10
HFS_BCRYPT_ROUNDS=12
HFS_BUSINESS_NAME=Hotel Food Service
HFS_BUSINESS_ADDRESS=
HFS_TAX_ID=
HFS_BILL_FOOTER=Thank you for dining with us
# Created at start-up when missing; the only way into an empty production database.
HFS_ADMIN_EMAIL=owner@yourhotel.example
HFS_ADMIN_PASSWORD=choose-a-long-password
